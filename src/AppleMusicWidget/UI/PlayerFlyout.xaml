<Window x:Class="AppleMusicWidget.UI.PlayerFlyout"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:globalization="clr-namespace:System.Globalization;assembly=System.Private.CoreLib"
        xml:lang=""
        Width="350" Height="150"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        WindowStyle="None" AllowsTransparency="False" Background="Transparent"
        ShowInTaskbar="False" ShowActivated="False"
        ResizeMode="NoResize" Topmost="True">
    <!-- Phase 4b: real Fluent material — DWM acrylic (DWMSBT_TRANSIENTWINDOW) +
         rounded overlay corners are applied in OnSourceInitialized; FlyoutBg is a
         mostly-transparent tint so the system material shows through.
         Layout = former desktop PlayerWidget card (PLAN §3.3). -->
    <Window.Resources>
        <Style x:Key="FlatButton" TargetType="Button">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="FontFamily" Value="Segoe Fluent Icons" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TxtPrimary}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource BtnHover}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource BtnPressed}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource TxtDisabled}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PlayPauseButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Content" Value="&#xE768;" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                    <Setter Property="Content" Value="&#xE769;" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border x:Name="Root" CornerRadius="8" Background="{DynamicResource FlyoutBg}"
            BorderBrush="{DynamicResource FlyoutBorder}" BorderThickness="1">
        <Grid>
            <Grid x:Name="PlayerView" Margin="14,12,14,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="64" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Track info: hover pill like the transport buttons; click brings
                     Apple Music to the foreground (PLAN: Apple Musicへの導線). -->
                <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" CornerRadius="4"
                        Margin="-6,-4,-6,0" Padding="6,4"
                        Cursor="Hand" MouseLeftButtonDown="OnTrackClick"
                        ToolTip="Apple Music を開く">
                    <Border.Style>
                        <Style TargetType="Border">
                            <!-- setter, not a local value: local values outrank triggers -->
                            <Setter Property="Background" Value="Transparent" />
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource TrackHover}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="64" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Grid Width="64" Height="64" VerticalAlignment="Top" IsHitTestVisible="False">
                            <Border CornerRadius="8" Background="#20808080" />
                            <Image x:Name="ArtworkImage" Source="{Binding Artwork}"
                                   Stretch="UniformToFill" SizeChanged="OnArtworkSizeChanged" />
                        </Grid>

                        <StackPanel Grid.Column="2" VerticalAlignment="Top">
                            <TextBlock Text="{Binding Title}" ToolTip="{Binding Title}"
                                       Foreground="{DynamicResource TxtPrimary}" FontSize="14" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Subtitle}" ToolTip="{Binding Subtitle}"
                                       Foreground="{DynamicResource TxtSecondary}" FontSize="12" Margin="0,2,0,0"
                                       TextTrimming="CharacterEllipsis" />
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding ElapsedText}"
                                           Foreground="{DynamicResource TxtSecondary}" FontSize="11" VerticalAlignment="Center" />
                                <!-- Apple Music reports IsPlaybackPositionEnabled=false: a passive
                                     2px progress line (same look as the strip), not a slider. -->
                                <Grid Grid.Column="1" x:Name="ProgressTrack" VerticalAlignment="Center"
                                      Height="16" Margin="6,0">
                                    <Rectangle Height="2" Fill="#20808080" VerticalAlignment="Center" />
                                    <Rectangle x:Name="ProgressFill" Height="2" Fill="{DynamicResource AccentBrush}"
                                               HorizontalAlignment="Left" VerticalAlignment="Center" Width="0" />
                                </Grid>
                                <TextBlock Grid.Column="2" Text="{Binding RemainingText}"
                                           Foreground="{DynamicResource TxtSecondary}" FontSize="11" VerticalAlignment="Center" />
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>

                <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                            Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                    <Button Style="{StaticResource FlatButton}" Content="&#xE712;" Command="{Binding ActionMenuCommand}" ToolTip="その他の操作" />
                    <Button Style="{StaticResource FlatButton}" Content="&#xE892;" Command="{Binding PreviousCommand}" />
                    <Button Style="{StaticResource PlayPauseButton}" Command="{Binding PlayPauseCommand}" />
                    <Button Style="{StaticResource FlatButton}" Content="&#xE893;" Command="{Binding NextCommand}" />
                    <Button x:Name="QueueButton" Style="{StaticResource FlatButton}" Content="&#xE90B;"
                            Click="OnPlayQueueClick" ToolTip="再生待ちリスト" />
                </StackPanel>
            </Grid>
            <Grid x:Name="QueueView" Visibility="Collapsed" Margin="12,10,12,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="36" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button Style="{StaticResource FlatButton}" Content="&#xE72B;"
                            Click="OnQueueBackClick" ToolTip="戻る" />
                    <TextBlock Grid.Column="1" Text="再生キュー" FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource TxtPrimary}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <Button Grid.Column="2" x:Name="QueueRefreshButton" Style="{StaticResource FlatButton}" Content="&#xE72C;"
                            Click="OnQueueRefreshClick" ToolTip="更新" />
                </Grid>
                <ListBox Grid.Row="1" x:Name="QueueItems"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.CanContentScroll="True"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         VirtualizingPanel.ScrollUnit="Pixel"
                         ScrollViewer.PanningMode="VerticalOnly"
                         SelectionChanged="OnQueueSelectionChanged"
                         Margin="0,4,0,4"
                         Background="Transparent"
                         BorderThickness="0">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="IsTabStop" Value="False" />
                            <Setter Property="Margin" Value="0,1" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <TextBlock x:Name="HeaderText" Text="{Binding Title, ConverterCulture={x:Static globalization:CultureInfo.InvariantCulture}}"
                                           Visibility="Collapsed" Foreground="{DynamicResource TxtPrimary}"
                                           FontSize="14" FontWeight="SemiBold" Margin="8,10,8,6" />
                                <Border x:Name="CurrentRow" Visibility="Collapsed"
                                        Background="{DynamicResource CurrentTrackBg}" CornerRadius="6"
                                        Padding="8" Margin="0,2">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="3" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="40" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="3" CornerRadius="2"
                                                Background="{DynamicResource AccentBrush}" />
                                        <Grid Grid.Column="2" Width="40" Height="40">
                                            <Border CornerRadius="4" Background="#20808080" />
                                            <Image Source="{Binding DataContext.Artwork, RelativeSource={RelativeSource AncestorType=Window}, ConverterCulture={x:Static globalization:CultureInfo.InvariantCulture}}"
                                                   Stretch="UniformToFill" />
                                        </Grid>
                                        <StackPanel Grid.Column="4" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DataContext.Title, RelativeSource={RelativeSource AncestorType=Window}, ConverterCulture={x:Static globalization:CultureInfo.InvariantCulture}}"
                                                       ToolTip="{Binding DataContext.Title, RelativeSource={RelativeSource AncestorType=Window}, ConverterCulture={x:Static globalization:CultureInfo.InvariantCulture}}"
                                                       Foreground="{DynamicResource TxtPrimary}" FontSize="14" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding DataContext.Subtitle, RelativeSource={RelativeSource AncestorType=Window}, ConverterCulture={x:Static globalization:CultureInfo.InvariantCulture}}"
                                                       ToolTip="{Binding DataContext.Subtitle, RelativeSource={RelativeSource AncestorType=Window}, ConverterCulture={x:Static globalization:CultureInfo.InvariantCulture}}"
                                                       Foreground="{DynamicResource TxtSecondary}" FontSize="12" Margin="0,2,0,0"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="5" VerticalAlignment="Center" FontSize="12" Margin="8,0,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="一時停止" />
                                                    <Setter Property="Foreground" Value="{DynamicResource TxtSecondary}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding DataContext.IsPlaying, RelativeSource={RelativeSource AncestorType=Window}, ConverterCulture={x:Static globalization:CultureInfo.InvariantCulture}}" Value="True">
                                                            <Setter Property="Text" Value="再生中" />
                                                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Border>
                                <Border x:Name="TrackRow" Padding="8,7" CornerRadius="4" Margin="0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding Title, ConverterCulture={x:Static globalization:CultureInfo.InvariantCulture}}"
                                                   ToolTip="{Binding Title, ConverterCulture={x:Static globalization:CultureInfo.InvariantCulture}}"
                                                   Foreground="{DynamicResource TxtPrimary}" FontSize="14" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Duration, ConverterCulture={x:Static globalization:CultureInfo.InvariantCulture}}"
                                                   Foreground="{DynamicResource TxtSecondary}" FontSize="12" Margin="8,0,0,0" />
                                        <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Text="{Binding Subtitle, ConverterCulture={x:Static globalization:CultureInfo.InvariantCulture}}"
                                                   ToolTip="{Binding Subtitle, ConverterCulture={x:Static globalization:CultureInfo.InvariantCulture}}"
                                                   Foreground="{DynamicResource TxtSecondary}" FontSize="12"
                                                   TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </Border>
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsHeader, ConverterCulture={x:Static globalization:CultureInfo.InvariantCulture}}" Value="True">
                                    <Setter TargetName="HeaderText" Property="Visibility" Value="Visible" />
                                    <Setter TargetName="TrackRow" Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsCurrent, ConverterCulture={x:Static globalization:CultureInfo.InvariantCulture}}" Value="True">
                                    <Setter TargetName="CurrentRow" Property="Visibility" Value="Visible" />
                                    <Setter TargetName="TrackRow" Property="Visibility" Value="Collapsed" />
                                    <Setter TargetName="HeaderText" Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Grid.Row="2" x:Name="QueueStatus" Foreground="{DynamicResource TxtSecondary}"
                           FontSize="12" HorizontalAlignment="Center" Margin="0,4,0,0" />
            </Grid>
        </Grid>
    </Border>
</Window>
