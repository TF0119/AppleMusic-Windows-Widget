<Window x:Class="AppleMusicWidget.UI.PlayerFlyout"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="350" Height="150"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        WindowStyle="None" AllowsTransparency="False" Background="Transparent"
        ShowInTaskbar="False" ShowActivated="False"
        ResizeMode="NoResize" Topmost="True">
    <!-- Phase 4b: real Fluent material — DWM acrylic (DWMSBT_TRANSIENTWINDOW) +
         rounded overlay corners are applied in OnSourceInitialized; FlyoutBg is a
         mostly-transparent tint so the system material shows through.
         Layout = former desktop PlayerWidget card (PLAN §3.3). -->
    <Window.Resources>
        <Style x:Key="FlatButton" TargetType="Button">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="FontFamily" Value="Segoe Fluent Icons" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TxtPrimary}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource BtnHover}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource BtnPressed}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource TxtDisabled}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PlayPauseButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Content" Value="&#xE768;" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                    <Setter Property="Content" Value="&#xE769;" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border x:Name="Root" CornerRadius="8" Background="{DynamicResource FlyoutBg}"
            BorderBrush="{DynamicResource FlyoutBorder}" BorderThickness="1">
        <Grid Margin="14,12,14,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="64" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Track info: hover pill like the transport buttons; click brings
                 Apple Music to the foreground (PLAN: Apple Musicへの導線). -->
            <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" CornerRadius="4"
                    Margin="-6,-4,-6,0" Padding="6,4" Background="Transparent"
                    Cursor="Hand" MouseLeftButtonDown="OnTrackClick"
                    ToolTip="Apple Music を開く">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource TrackHover}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="64" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Grid Width="64" Height="64" VerticalAlignment="Top">
                        <Border CornerRadius="8" Background="#20808080" />
                        <Image x:Name="ArtworkImage" Source="{Binding Artwork}"
                               Stretch="UniformToFill" SizeChanged="OnArtworkSizeChanged" />
                    </Grid>

                    <StackPanel Grid.Column="2" VerticalAlignment="Top">
                        <TextBlock Text="{Binding Title}" ToolTip="{Binding Title}"
                                   Foreground="{DynamicResource TxtPrimary}" FontSize="14" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Subtitle}" ToolTip="{Binding Subtitle}"
                                   Foreground="{DynamicResource TxtSecondary}" FontSize="12" Margin="0,2,0,0"
                                   TextTrimming="CharacterEllipsis" />
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding ElapsedText}"
                                       Foreground="{DynamicResource TxtSecondary}" FontSize="11" VerticalAlignment="Center" />
                            <!-- Apple Music reports IsPlaybackPositionEnabled=false: a passive
                                 2px progress line (same look as the strip), not a slider. -->
                            <Grid Grid.Column="1" x:Name="ProgressTrack" VerticalAlignment="Center"
                                  Height="16" Margin="6,0">
                                <Rectangle Height="2" Fill="#20808080" VerticalAlignment="Center" />
                                <Rectangle x:Name="ProgressFill" Height="2" Fill="{DynamicResource AccentBrush}"
                                           HorizontalAlignment="Left" VerticalAlignment="Center" Width="0" />
                            </Grid>
                            <TextBlock Grid.Column="2" Text="{Binding RemainingText}"
                                       Foreground="{DynamicResource TxtSecondary}" FontSize="11" VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>

            <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                        Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                <Button Style="{StaticResource FlatButton}" Content="&#xE712;" IsEnabled="False" ToolTip="Phase 5" />
                <Button Style="{StaticResource FlatButton}" Content="&#xE892;" Command="{Binding PreviousCommand}" />
                <Button Style="{StaticResource PlayPauseButton}" Command="{Binding PlayPauseCommand}" />
                <Button Style="{StaticResource FlatButton}" Content="&#xE893;" Command="{Binding NextCommand}" />
                <Button Style="{StaticResource FlatButton}" Content="&#xE8FD;" IsEnabled="False" ToolTip="Phase 5" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
