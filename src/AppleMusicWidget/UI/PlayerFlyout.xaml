<Window x:Class="AppleMusicWidget.UI.PlayerFlyout"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="350" Height="150"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ShowActivated="False"
        ResizeMode="NoResize" Topmost="True">
    <!-- Phase 4: opens upward from TaskbarStrip, closes on focus loss.
         Layout = former desktop PlayerWidget card (PLAN §3.3). -->
    <Window.Resources>
        <Style x:Key="FlatButton" TargetType="Button">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Foreground" Value="{DynamicResource TxtPrimary}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource BtnHover}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource BtnPressed}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource TxtDisabled}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="Root" CornerRadius="12" Background="{DynamicResource FlyoutBg}"
            BorderBrush="{DynamicResource FlyoutBorder}" BorderThickness="1">
        <Grid Margin="14,12,14,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="64" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Row="0" Grid.Column="0" Width="64" Height="64" VerticalAlignment="Top">
                <Border CornerRadius="8" Background="#20808080" />
                <Image x:Name="ArtworkImage" Source="{Binding Artwork}"
                       Stretch="UniformToFill" SizeChanged="OnArtworkSizeChanged" />
            </Grid>

            <StackPanel Grid.Row="0" Grid.Column="2" VerticalAlignment="Top">
                <TextBlock Text="{Binding Title}" ToolTip="{Binding Title}"
                           Foreground="{DynamicResource TxtPrimary}" FontSize="15" FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Subtitle}" ToolTip="{Binding Subtitle}"
                           Foreground="{DynamicResource TxtSecondary}" FontSize="12" Margin="0,2,0,0"
                           TextTrimming="CharacterEllipsis" />
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding ElapsedText}"
                               Foreground="{DynamicResource TxtSecondary}" FontSize="10" VerticalAlignment="Center" />
                    <!-- Apple Music reports IsPlaybackPositionEnabled=false: a passive
                         2px progress line (same look as the strip), not a slider. -->
                    <Grid Grid.Column="1" x:Name="ProgressTrack" VerticalAlignment="Center"
                          Height="16" Margin="6,0">
                        <Rectangle Height="2" Fill="#20808080" VerticalAlignment="Center" />
                        <Rectangle x:Name="ProgressFill" Height="2" Fill="{DynamicResource AccentBrush}"
                                   HorizontalAlignment="Left" VerticalAlignment="Center" Width="0" />
                    </Grid>
                    <TextBlock Grid.Column="2" Text="{Binding RemainingText}"
                               Foreground="{DynamicResource TxtSecondary}" FontSize="10" VerticalAlignment="Center" />
                </Grid>
            </StackPanel>

            <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                        Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                <Button Style="{StaticResource FlatButton}" Content="…" IsEnabled="False" ToolTip="Phase 5" />
                <Button Style="{StaticResource FlatButton}" Content="⏮" Command="{Binding PreviousCommand}" />
                <Button Style="{StaticResource FlatButton}" Content="{Binding PlayPauseGlyph}"
                        FontSize="15" Command="{Binding PlayPauseCommand}" />
                <Button Style="{StaticResource FlatButton}" Content="⏭" Command="{Binding NextCommand}" />
                <Button Style="{StaticResource FlatButton}" Content="☰" IsEnabled="False" ToolTip="Phase 5" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
