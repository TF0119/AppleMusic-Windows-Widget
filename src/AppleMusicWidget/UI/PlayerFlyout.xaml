<Window x:Class="AppleMusicWidget.UI.PlayerFlyout"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="350" Height="150"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ShowActivated="False"
        ResizeMode="NoResize">
    <!-- Phase 4: opens upward from TaskbarStrip, closes on focus loss.
         Layout = former desktop PlayerWidget card (PLAN §3.3). -->
    <Window.Resources>
        <Style x:Key="FlatButton" TargetType="Button">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#22FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#55FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="Root" CornerRadius="12" Background="#E61C1C1E">
        <Grid Margin="14,12,14,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="64" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Row="0" Grid.Column="0" Width="64" Height="64" VerticalAlignment="Top">
                <Border CornerRadius="8" Background="#33FFFFFF" />
                <Image x:Name="ArtworkImage" Source="{Binding Artwork}"
                       Stretch="UniformToFill" SizeChanged="OnArtworkSizeChanged" />
            </Grid>

            <StackPanel Grid.Row="0" Grid.Column="2" VerticalAlignment="Top">
                <TextBlock Text="{Binding Title}" ToolTip="{Binding Title}"
                           Foreground="White" FontSize="15" FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Subtitle}" ToolTip="{Binding Subtitle}"
                           Foreground="#B3FFFFFF" FontSize="12" Margin="0,2,0,0"
                           TextTrimming="CharacterEllipsis" />
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding ElapsedText}"
                               Foreground="#B3FFFFFF" FontSize="10" VerticalAlignment="Center" />
                    <Slider x:Name="SeekSlider" Grid.Column="1"
                            Minimum="0" Maximum="1" Value="0"
                            IsMoveToPointEnabled="True"
                            IsEnabled="{Binding CanSeek}"
                            VerticalAlignment="Center" Margin="6,0" Height="16"
                            PreviewMouseLeftButtonDown="OnSeekDown"
                            PreviewMouseLeftButtonUp="OnSeekUp">
                        <Slider.Style>
                            <Style TargetType="Slider">
                                <!-- Disabled = read-only progress bar; keep it looking normal. -->
                                <Style.Triggers>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Opacity" Value="1" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Slider.Style>
                    </Slider>
                    <TextBlock Grid.Column="2" Text="{Binding RemainingText}"
                               Foreground="#B3FFFFFF" FontSize="10" VerticalAlignment="Center" />
                </Grid>
            </StackPanel>

            <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                        Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                <Button Style="{StaticResource FlatButton}" Content="…" IsEnabled="False" ToolTip="Phase 5" />
                <Button Style="{StaticResource FlatButton}" Content="⏮" Command="{Binding PreviousCommand}" />
                <Button Style="{StaticResource FlatButton}" Content="{Binding PlayPauseGlyph}"
                        FontSize="15" Command="{Binding PlayPauseCommand}" />
                <Button Style="{StaticResource FlatButton}" Content="⏭" Command="{Binding NextCommand}" />
                <Button Style="{StaticResource FlatButton}" Content="☰" IsEnabled="False" ToolTip="Phase 5" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
